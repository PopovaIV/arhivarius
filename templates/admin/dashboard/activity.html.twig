{% extends 'base.html.twig' %}
{% block title %}Журнал активности — Админ{% endblock %}

{% set action_labels = {
    'login': 'Вход',
    'logout': 'Выход',
    'login_failed': 'Ошибка входа',
    'page_view': 'Просмотр страницы',
    'document_view': 'Просмотр документа',
    'document_download': 'Скачивание документа',
    'document_create': 'Добавление документа',
    'document_delete': 'Удаление документа',
    'book_open': 'Открытие книги',
    'book_download': 'Скачивание книги',
    'book_read_progress': 'Чтение книги',
    'photo_upload': 'Загрузка фото',
    'user_create': 'Создание пользователя',
    'user_deactivate': 'Блокировка пользователя'
} %}

{% block body %}
<h2 class="mb-3"><i class="bi bi-clock-history"></i> Журнал активности</h2>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label small">Пользователь</label>
                <select name="user" class="form-select form-select-sm">
                    <option value="">— все —</option>
                    {% for u in users %}
                        <option value="{{ u.id }}" {{ filters.user is defined and filters.user.id == u.id ? 'selected' }}>
                            {{ u.displayName }} ({{ u.username }})
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small">Действие</label>
                <select name="action" class="form-select form-select-sm">
                    <option value="">— все —</option>
                    {% for value, label in action_labels %}
                        <option value="{{ value }}" {{ filters.action is defined and filters.action == value ? 'selected' }}>
                            {{ label }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small">С</label>
                <input type="date" name="from" class="form-control form-control-sm"
                       value="{{ filters.from is defined ? filters.from|date('Y-m-d') }}">
            </div>
            <div class="col-md-2">
                <label class="form-label small">По</label>
                <input type="date" name="to" class="form-control form-control-sm"
                       value="{{ filters.to is defined ? filters.to|date('Y-m-d') }}">
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100">Применить</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Время</th>
                    <th>Пользователь</th>
                    <th>Действие</th>
                    <th>Объект</th>
                    <th>Детали</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
            {% for log in items %}
                <tr>
                    <td class="small text-nowrap">{{ log.createdAt|date('d.m.Y H:i:s') }}</td>
                    <td>
                        {% if log.user %}
                            <a href="{{ path('admin_activity_user_profile', {id: log.user.id}) }}">
                                {{ log.user.displayName }}
                            </a>
                        {% else %}<span class="text-muted">—</span>{% endif %}
                    </td>
                    <td><span class="badge bg-light text-dark">{{ action_labels[log.action] ?? log.action }}</span></td>
                    <td class="small">
                        {% if log.entityType %}{{ log.entityType }}#{{ log.entityId }}{% endif %}
                    </td>
                    <td class="small text-muted" style="max-width: 400px; overflow:hidden; text-overflow:ellipsis;">
                        {% if log.metadata %}
                            {% for k, v in log.metadata %}
                                <span class="me-2"><strong>{{ k }}:</strong> {{ v|json_encode }}</span>
                            {% endfor %}
                        {% endif %}
                    </td>
                    <td class="small text-muted">{{ log.ip }}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">Записей не найдено</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>

{% if items|length >= 50 %}
<nav class="mt-3">
    <ul class="pagination">
        {% if page > 1 %}
            <li class="page-item">
                <a class="page-link" href="?{{ app.request.query.all|merge({page: page - 1})|url_encode }}">← Предыдущая</a>
            </li>
        {% endif %}
        <li class="page-item active"><span class="page-link">Страница {{ page }}</span></li>
        <li class="page-item">
            <a class="page-link" href="?{{ app.request.query.all|merge({page: page + 1})|url_encode }}">Следующая →</a>
        </li>
    </ul>
</nav>
{% endif %}
{% endblock %}
