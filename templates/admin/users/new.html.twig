{% extends 'base.html.twig' %}
{% block title %}Новый пользователь — Админ{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6">
        <h2 class="mb-4"><i class="bi bi-person-plus"></i> Новый пользователь</h2>
        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form) }}
                {{ form_row(form.username) }}
                {{ form_row(form.displayName) }}
                {{ form_row(form.email) }}
                {{ form_row(form.plainPassword.first) }}
                {{ form_row(form.plainPassword.second) }}
                {{ form_row(form.role) }}
                {{ form_row(form.active) }}
                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('admin_users_index') }}" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Создать</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
