{% extends 'base.html.twig' %}
{% block title %}Библиотека — {{ app_name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-book"></i> Библиотека <small class="text-muted">{{ total }}</small></h2>
    {% if is_granted('ROLE_CONTRIBUTOR') %}
    <a href="{{ path('books_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Добавить книгу
    </a>
    {% endif %}
</div>

<div class="card mb-3">
    <div class="card-body">
        <ul class="nav nav-pills mb-3" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="pill" data-bs-target="#filter-meta">
                    <i class="bi bi-tags"></i> По названию и автору
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="pill" data-bs-target="#filter-content">
                    <i class="bi bi-search"></i> По содержимому
                </button>
            </li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane fade show active" id="filter-meta">
                <form method="get" class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label small">Название или автор</label>
                        <input type="search" name="q" value="{{ filters.q ?? '' }}" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Язык</label>
                        <select name="language" class="form-select form-select-sm">
                            <option value="">— все —</option>
                            {% for l in languages %}
                                <option value="{{ l }}" {{ filters.language == l ? 'selected' }}>{{ l }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">Год от</label>
                        <input type="number" name="year_from" value="{{ filters.year_from ?? '' }}" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small">до</label>
                        <input type="number" name="year_to" value="{{ filters.year_to ?? '' }}" class="form-control form-control-sm">
                    </div>
                    <div class="col-md-1">
                        <button class="btn btn-primary btn-sm w-100">Найти</button>
                    </div>
                </form>
            </div>
            <div class="tab-pane fade" id="filter-content">
                <form method="get" action="{{ path('books_search') }}" class="row g-2 align-items-end">
                    <div class="col-md-10">
                        <label class="form-label small">Поиск по тексту внутри книг</label>
                        <input type="search" name="q" class="form-control form-control-sm" placeholder="Например: «Иванов» или «Тамбовская губерния»">
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary btn-sm w-100"><i class="bi bi-search"></i> Искать</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    {% for b in books %}
        {% set progress = progress_map[b.id] ?? null %}
        <div class="col-md-6 col-lg-4 col-xl-3">
            <div class="card h-100 shadow-sm">
                <a href="{{ path('books_show', {id: b.id}) }}" class="text-decoration-none text-dark">
                    <div class="card-body">
                        <div class="d-flex align-items-start">
                            <div class="me-3" style="flex-shrink: 0;">
                                {% if b.hasCover %}
                                    <img src="{{ path('books_cover', {id: b.id}) }}" alt="" class="rounded shadow-sm"
                                         style="width: 70px; height: 90px; object-fit: cover;">
                                {% else %}
                                    <div class="d-flex align-items-center justify-content-center bg-light rounded"
                                         style="width: 70px; height: 90px;">
                                        <i class="bi bi-book fs-2 text-secondary"></i>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="flex-grow-1 min-width-0">
                                <h6 class="card-title mb-1 text-break">{{ b.title }}</h6>
                                {% if b.authors %}
                                    <div class="small text-muted text-break">{{ b.authors }}</div>
                                {% endif %}
                                <div class="small text-muted mt-1">
                                    {% if b.year %}{{ b.year }}{% endif %}
                                    {% if b.language %} · {{ b.language|upper }}{% endif %}
                                </div>
                            </div>
                        </div>
                        <div class="mt-2">
                            {% for f in b.files %}
                                <span class="badge bg-light text-dark border me-1" title="{{ f.originalName }}">
                                    {{ f.format.label }}
                                </span>
                            {% endfor %}
                        </div>
                        {% if progress and progress.percent %}
                        <div class="mt-2">
                            <div class="progress" style="height: 4px;">
                                <div class="progress-bar bg-success" style="width: {{ progress.percent }}%;"></div>
                            </div>
                            <div class="small text-muted mt-1">прочитано: {{ progress.percent }}%</div>
                        </div>
                        {% endif %}
                    </div>
                </a>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="text-center text-muted py-5">
                Книг пока нет.
                {% if is_granted('ROLE_CONTRIBUTOR') %}
                    <a href="{{ path('books_new') }}">Добавить первую</a>?
                {% endif %}
            </div>
        </div>
    {% endfor %}
</div>

{% set pages = (total / per_page)|round(0, 'ceil') %}
{% if pages > 1 %}
<nav class="mt-3">
    <ul class="pagination">
        {% for p in 1..pages %}
            <li class="page-item {{ p == page ? 'active' }}">
                <a class="page-link" href="?{{ app.request.query.all|merge({page: p})|url_encode }}">{{ p }}</a>
            </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endblock %}
