{% extends 'base.html.twig' %}
{% block title %}Новая книга — Библиотека{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <a href="{{ path('books_index') }}" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-left"></i> Библиотека
        </a>
        <h2 class="mt-1 mb-4"><i class="bi bi-book"></i> Новая книга</h2>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
                {{ form_row(form.title) }}
                {{ form_row(form.authors) }}
                <div class="row">
                    <div class="col-md-3">{{ form_row(form.year) }}</div>
                    <div class="col-md-3">{{ form_row(form.language) }}</div>
                    <div class="col-md-6">{{ form_row(form.publisher) }}</div>
                </div>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.genre) }}</div>
                    <div class="col-md-6">{{ form_row(form.isbn) }}</div>
                </div>
                {{ form_row(form.description) }}
                <hr>
                {{ form_row(form.uploadFiles) }}
                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('books_index') }}" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Добавить</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
