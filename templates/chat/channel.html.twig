{% extends 'base.html.twig' %}
{% block title %}{{ channel.public ? 'Общий чат' : ('Диалог с ' ~ other.displayName) }} — Чат{% endblock %}

{% block stylesheets %}
<style>
    #chat-shell { display: flex; gap: 1rem; height: calc(100vh - 100px); }
    #chat-sidebar { width: 280px; flex-shrink: 0; overflow-y: auto; }
    #chat-main { flex-grow: 1; display: flex; flex-direction: column; background: #fff; border: 1px solid #dee2e6; border-radius: 0.5rem; overflow: hidden; }
    #chat-header { padding: 0.75rem 1rem; border-bottom: 1px solid #dee2e6; background: #f8f9fa; }
    #chat-messages { flex-grow: 1; overflow-y: auto; padding: 1rem; background: #f1f3f5; }
    #chat-input-box { padding: 0.75rem; border-top: 1px solid #dee2e6; background: #fff; }
    .msg { margin-bottom: 0.75rem; max-width: 75%; }
    .msg.mine { margin-left: auto; }
    .msg-bubble { padding: 0.5rem 0.75rem; border-radius: 0.5rem; word-wrap: break-word; white-space: pre-wrap; }
    .msg.mine .msg-bubble { background: #d4edda; }
    .msg.theirs .msg-bubble { background: #fff; border: 1px solid #e9ecef; }
    .msg-meta { font-size: 0.75rem; color: #6c757d; margin-top: 0.2rem; }
    .msg.mine .msg-meta { text-align: right; }
    .msg-delete { opacity: 0; transition: opacity 0.15s; cursor: pointer; }
    .msg:hover .msg-delete { opacity: 1; }
    .sidebar-link { display: block; padding: 0.5rem 0.75rem; color: #212529; text-decoration: none; border-radius: 0.4rem; margin-bottom: 2px; }
    .sidebar-link:hover { background: #f8f9fa; color: #212529; }
    .sidebar-link.active { background: #0d6efd; color: #fff; }
    .sidebar-link.active .text-muted { color: rgba(255,255,255,0.75) !important; }
    .unread-badge { background: #dc3545; color: #fff; padding: 0.1rem 0.45rem; border-radius: 999px; font-size: 0.75rem; }
</style>
{% endblock %}

{% block body %}
<div id="chat-shell">
    <div id="chat-sidebar">
        <a href="{{ path('chat_public') }}" class="sidebar-link {{ channel.public ? 'active' }}">
            <i class="bi bi-megaphone"></i> <strong>Общий чат</strong>
            <div class="small text-muted">Видят все</div>
        </a>
        <a href="{{ path('chat_contacts') }}" class="sidebar-link">
            <i class="bi bi-person-plus"></i> Написать кому-то
        </a>
        <div class="text-muted text-uppercase small mt-3 mb-1 px-2">Диалоги</div>
        {% for d in directs %}
            <a href="{{ path('chat_direct', {otherId: d.other.id}) }}"
               class="sidebar-link {{ channel.id == d.channel.id ? 'active' }}">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-person-circle"></i> {{ d.other.displayName }}
                    </div>
                    {% if d.unread > 0 and channel.id != d.channel.id %}
                        <span class="unread-badge">{{ d.unread }}</span>
                    {% endif %}
                </div>
            </a>
        {% else %}
            <div class="small text-muted px-2">Нет диалогов</div>
        {% endfor %}
    </div>

    <div id="chat-main">
        <div id="chat-header">
            {% if channel.public %}
                <i class="bi bi-megaphone"></i> <strong>Общий чат</strong>
                <span class="text-muted small ms-2">видят все участники архива</span>
            {% else %}
                <i class="bi bi-person-circle"></i> <strong>{{ other.displayName }}</strong>
                <span class="text-muted small ms-2">личная беседа</span>
            {% endif %}
        </div>
        <div id="chat-messages"></div>
        <div id="chat-input-box">
            <form id="msg-form" class="d-flex gap-2">
                <input id="msg-input" type="text" class="form-control" placeholder="Сообщение..." maxlength="5000" autocomplete="off">
                <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i></button>
            </form>
        </div>
    </div>
</div>

<script>
(function() {
    const CHANNEL_ID = {{ channel.id }};
    const POLL_URL = {{ path('chat_poll', {channelId: channel.id})|json_encode|raw }};
    const SEND_URL = {{ path('chat_send', {channelId: channel.id})|json_encode|raw }};
    const READ_URL = {{ path('chat_read', {channelId: channel.id})|json_encode|raw }};
    const DELETE_URL_TPL = {{ path('chat_message_delete', {id: 0})|json_encode|raw }};
    const INITIAL_MESSAGES = {{ messages|json_encode|raw }};
    let lastId = {{ last_id }};

    const messagesContainer = document.getElementById('chat-messages');
    const form = document.getElementById('msg-form');
    const input = document.getElementById('msg-input');

    function renderInitial() {
        messagesContainer.innerHTML = '';
        for (const m of INITIAL_MESSAGES) {
            appendMessage(m);
        }
        scrollToBottom();
    }

    function appendMessage(m) {
        const el = document.createElement('div');
        el.className = 'msg ' + (m.is_mine ? 'mine' : 'theirs');
        el.dataset.msgId = m.id;
        const time = new Date(m.created_at).toLocaleString('ru-RU', { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' });
        el.innerHTML = `
            <div class="msg-bubble">${escapeHtml(m.body)}</div>
            <div class="msg-meta">
                ${!m.is_mine ? `<strong>${escapeHtml(m.author_name)}</strong> · ` : ''}
                ${time}
                ${m.can_delete ? ` · <span class="msg-delete text-danger" data-id="${m.id}">удалить</span>` : ''}
            </div>
        `;
        messagesContainer.appendChild(el);

        if (m.can_delete) {
            el.querySelector('.msg-delete')?.addEventListener('click', () => deleteMessage(m.id, el));
        }
    }

    function scrollToBottom() {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    async function sendMessage(body) {
        try {
            const res = await fetch(SEND_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ body: body }),
            });
            if (!res.ok) {
                console.warn('Send failed', res.status);
                return false;
            }
            const m = await res.json();
            appendMessage(m);
            lastId = Math.max(lastId, m.id);
            scrollToBottom();
            return true;
        } catch (e) {
            console.warn(e);
            return false;
        }
    }

    async function deleteMessage(id, el) {
        if (!confirm('Удалить сообщение?')) return;
        try {
            const url = DELETE_URL_TPL.replace(/\/0$/, '/' + id);
            const res = await fetch(url, { method: 'POST', credentials: 'same-origin' });
            if (res.ok) {
                el.remove();
            }
        } catch (e) { console.warn(e); }
    }

    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = input.value.trim();
        if (body === '') return;
        input.disabled = true;
        const ok = await sendMessage(body);
        input.disabled = false;
        if (ok) {
            input.value = '';
            input.focus();
        }
    });

    // Long polling. Каждый запрос ждёт до 25 сек на сервере;
    // если приходят новые сообщения — рисуем и сразу снова в очередь.
    async function pollLoop() {
        while (true) {
            try {
                const res = await fetch(POLL_URL + '?since=' + lastId + '&wait=25', { credentials: 'same-origin' });
                if (!res.ok) {
                    await sleep(5000);
                    continue;
                }
                const data = await res.json();
                if (Array.isArray(data.items) && data.items.length > 0) {
                    for (const m of data.items) {
                        appendMessage(m);
                    }
                    lastId = data.last_id;
                    scrollToBottom();
                    markRead();
                }
            } catch (e) {
                await sleep(5000);
            }
        }
    }

    async function markRead() {
        try {
            await fetch(READ_URL, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify({ last_id: lastId }),
            });
        } catch (e) {}
    }

    function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, c => ({
            '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
        })[c]).replace(/\n/g, '<br>');
    }

    renderInitial();
    pollLoop();
    input.focus();
})();
</script>
{% endblock %}
