{% extends 'base.html.twig' %}
{% block title %}Контакты — Чат{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-chat-dots"></i> Контакты</h2>
    <a href="{{ path('chat_public') }}" class="btn btn-outline-secondary">
        <i class="bi bi-megaphone"></i> Общий чат
    </a>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header"><i class="bi bi-chat-text"></i> Существующие диалоги</div>
            <div class="list-group list-group-flush">
                {% for d in directs %}
                    <a href="{{ path('chat_direct', {otherId: d.other.id}) }}" class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <i class="bi bi-person-circle text-muted"></i>
                                <strong>{{ d.other.displayName }}</strong>
                                <div class="small text-muted">{{ d.other.username }}</div>
                            </div>
                            {% if d.unread > 0 %}
                                <span class="badge bg-danger">{{ d.unread }}</span>
                            {% endif %}
                        </div>
                    </a>
                {% else %}
                    <div class="list-group-item text-center text-muted py-4">Диалогов ещё нет</div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header"><i class="bi bi-person-plus"></i> Начать новый диалог</div>
            <div class="list-group list-group-flush">
                {% for u in available %}
                    <a href="{{ path('chat_direct', {otherId: u.id}) }}" class="list-group-item list-group-item-action">
                        <i class="bi bi-person text-muted"></i>
                        <strong>{{ u.displayName }}</strong>
                        <span class="small text-muted">({{ u.username }})</span>
                    </a>
                {% else %}
                    <div class="list-group-item text-center text-muted py-4">Все остальные пользователи уже в диалогах</div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
