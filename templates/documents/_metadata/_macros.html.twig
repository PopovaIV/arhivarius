{# Универсальные макросы для отображения metadata #}

{% macro field(label, value) %}
    {% if value is not null and value != '' %}
        <div class="row mb-2">
            <dt class="col-sm-4 text-muted small">{{ label }}</dt>
            <dd class="col-sm-8 mb-0">{{ value }}</dd>
        </div>
    {% endif %}
{% endmacro %}

{% macro list(label, items) %}
    {% if items is iterable and items|length > 0 %}
        <div class="mb-3">
            <div class="text-muted small mb-1">{{ label }}</div>
            <ul class="mb-0 small">
            {% for item in items %}
                <li>{{ item }}</li>
            {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endmacro %}

{% macro card_start(title, icon) %}
    <div class="card shadow-sm">
        <div class="card-header bg-light"><i class="bi {{ icon }}"></i> {{ title }}</div>
        <div class="card-body">
{% endmacro %}

{% macro card_end() %}
        </div>
    </div>
{% endmacro %}
