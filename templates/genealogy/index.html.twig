{% extends 'base.html.twig' %}
{% block title %}Генеалогическое древо — {{ app_name }}{% endblock %}

{% block stylesheets %}
<style>
    #tree-canvas { width: 100%; height: 75vh; background: #f8f9fa; border: 1px solid #dee2e6; border-radius: 0.5rem; }
    .node rect {
        stroke-width: 1.5px;
        rx: 4; ry: 4;
        cursor: pointer;
    }
    .node text { font-size: 12px; pointer-events: none; }
    .node.male rect { fill: #d4e6f1; stroke: #2980b9; }
    .node.female rect { fill: #f5d4d4; stroke: #c0392b; }
    .node.unknown rect { fill: #ecf0f1; stroke: #7f8c8d; }
    .link.parent { fill: none; stroke: #555; stroke-width: 1.5px; }
    .link.spouse { fill: none; stroke: #e67e22; stroke-width: 2px; stroke-dasharray: 4 2; }
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2><i class="bi bi-diagram-3"></i> Генеалогическое древо</h2>
        <div class="text-muted small">
            Людей в реестре: {{ persons_total }} · Связей: {{ relations_total }}
        </div>
    </div>
    <div class="btn-group">
        {% if is_granted('ROLE_CONTRIBUTOR') %}
        <a href="{{ path('genealogy_gedcom_import') }}" class="btn btn-outline-primary">
            <i class="bi bi-upload"></i> Импорт GEDCOM
        </a>
        {% endif %}
        <a href="{{ path('genealogy_gedcom_export') }}" class="btn btn-outline-secondary">
            <i class="bi bi-download"></i> Экспорт GEDCOM
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div id="tree-canvas"></div>
        <div class="d-flex justify-content-between align-items-center mt-2">
            <div class="small text-muted">
                <span class="badge" style="background:#d4e6f1;color:#2980b9;border:1px solid #2980b9;">мужчины</span>
                <span class="badge" style="background:#f5d4d4;color:#c0392b;border:1px solid #c0392b;">женщины</span>
                <span class="badge bg-light text-dark border">пол не указан</span>
                · <span style="color:#555;">— родительство</span>
                · <span style="color:#e67e22;">--- брак</span>
            </div>
            <div class="btn-group btn-group-sm">
                <button id="zoom-in" class="btn btn-outline-secondary"><i class="bi bi-zoom-in"></i></button>
                <button id="zoom-out" class="btn btn-outline-secondary"><i class="bi bi-zoom-out"></i></button>
                <button id="zoom-fit" class="btn btn-outline-secondary"><i class="bi bi-arrows-fullscreen"></i></button>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/d3@7/dist/d3.min.js"></script>
<script>
(async function() {
    const TREE_URL = {{ path('genealogy_tree_json')|json_encode|raw }};
    const PERSON_URL_TPL = {{ path('persons_show', {id: 0})|json_encode|raw }};

    const container = document.getElementById('tree-canvas');
    const res = await fetch(TREE_URL, { credentials: 'same-origin' });
    const data = await res.json();

    if (data.nodes.length === 0) {
        container.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 text-muted">' +
            'В реестре ещё нет людей. <a class="ms-2" href="{{ path('persons_new') }}">Добавьте первую запись</a></div>';
        return;
    }

    const width = container.clientWidth;
    const height = container.clientHeight;

    const svg = d3.select('#tree-canvas').append('svg')
        .attr('width', width).attr('height', height);

    const g = svg.append('g');

    // Zoom
    const zoom = d3.zoom().scaleExtent([0.1, 3]).on('zoom', (e) => g.attr('transform', e.transform));
    svg.call(zoom);
    document.getElementById('zoom-in').onclick = () => svg.transition().call(zoom.scaleBy, 1.3);
    document.getElementById('zoom-out').onclick = () => svg.transition().call(zoom.scaleBy, 1/1.3);
    document.getElementById('zoom-fit').onclick = () => svg.transition().call(zoom.transform, d3.zoomIdentity);

    // Подготовка узлов и связей для d3-force
    const nodes = data.nodes.map(n => ({ ...n }));
    const links = data.edges.map(e => ({
        source: e.from, target: e.to, type: e.type,
    }));

    const sim = d3.forceSimulation(nodes)
        .force('link', d3.forceLink(links).id(d => d.id).distance(d => d.type === 'spouse' ? 60 : 100))
        .force('charge', d3.forceManyBody().strength(-400))
        .force('center', d3.forceCenter(width / 2, height / 2))
        .force('collide', d3.forceCollide(60))
        // Чуть-чуть выстраиваем по поколениям: родители выше, дети ниже
        .force('y', d3.forceY(d => d.birth_year ? Math.min(800, (d.birth_year - 1700) * 4) : 0).strength(0.05));

    const linkSel = g.append('g').selectAll('line')
        .data(links).enter().append('line')
        .attr('class', d => 'link ' + d.type);

    const nodeSel = g.append('g').selectAll('g')
        .data(nodes).enter().append('g')
        .attr('class', d => 'node ' + (d.gender || 'unknown'))
        .style('cursor', 'pointer')
        .on('click', (event, d) => {
            window.location.href = PERSON_URL_TPL.replace('/0', '/' + d.id);
        })
        .call(d3.drag()
            .on('start', (event, d) => {
                if (!event.active) sim.alphaTarget(0.3).restart();
                d.fx = d.x; d.fy = d.y;
            })
            .on('drag', (event, d) => { d.fx = event.x; d.fy = event.y; })
            .on('end', (event, d) => {
                if (!event.active) sim.alphaTarget(0);
                d.fx = null; d.fy = null;
            }));

    nodeSel.append('rect').attr('x', -70).attr('y', -22).attr('width', 140).attr('height', 44);
    nodeSel.append('text').attr('text-anchor', 'middle').attr('y', -4)
        .style('font-weight', 'bold').style('fill', '#222')
        .text(d => d.name.length > 22 ? d.name.substring(0, 20) + '…' : d.name);
    nodeSel.append('text').attr('text-anchor', 'middle').attr('y', 12)
        .style('fill', '#555').style('font-size', '11px')
        .text(d => d.lifespan && d.lifespan !== '?' ? d.lifespan : '');

    sim.on('tick', () => {
        linkSel
            .attr('x1', d => d.source.x).attr('y1', d => d.source.y)
            .attr('x2', d => d.target.x).attr('y2', d => d.target.y);
        nodeSel.attr('transform', d => `translate(${d.x},${d.y})`);
    });
})();
</script>
{% endblock %}
