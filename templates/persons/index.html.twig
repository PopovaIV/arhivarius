{% extends 'base.html.twig' %}
{% block title %}Люди — {{ app_name }}{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="bi bi-people"></i> Реестр людей <small class="text-muted">{{ total }}</small></h2>
    {% if is_granted('ROLE_CONTRIBUTOR') %}
    <a href="{{ path('persons_new') }}" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Добавить
    </a>
    {% endif %}
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-10">
                <label class="form-label small">Поиск по имени или прозвищу</label>
                <input type="search" name="q" value="{{ q ?? '' }}" class="form-control form-control-sm" autofocus>
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary btn-sm w-100">Найти</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="list-group list-group-flush">
        {% for p in persons %}
            <a href="{{ path('persons_show', {id: p.id}) }}" class="list-group-item list-group-item-action">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <i class="bi bi-person-circle text-muted"></i>
                        <strong>{{ p.fullName }}</strong>
                        {% if p.aliases %}
                            <span class="text-muted small">({{ p.aliases }})</span>
                        {% endif %}
                    </div>
                    <div class="small text-muted">{{ p.lifespanLabel }}</div>
                </div>
            </a>
        {% else %}
            <div class="list-group-item text-center text-muted py-5">
                Никого пока нет.
                {% if is_granted('ROLE_CONTRIBUTOR') %}
                    <a href="{{ path('persons_new') }}">Добавить первую запись</a>?
                {% endif %}
            </div>
        {% endfor %}
    </div>
</div>

{% set pages = (total / per_page)|round(0, 'ceil') %}
{% if pages > 1 %}
<nav class="mt-3">
    <ul class="pagination">
        {% for pg in 1..pages %}
            <li class="page-item {{ pg == page ? 'active' }}">
                <a class="page-link" href="?{{ app.request.query.all|merge({page: pg})|url_encode }}">{{ pg }}</a>
            </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endblock %}
