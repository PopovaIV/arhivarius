{% extends 'base.html.twig' %}
{% block title %}Новая запись о человеке{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <a href="{{ path('persons_index') }}" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-left"></i> Реестр людей
        </a>
        <h2 class="mt-1 mb-4"><i class="bi bi-person-plus"></i> Новая запись</h2>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form) }}
                {{ form_row(form.fullName) }}
                {{ form_row(form.aliases) }}
                {{ form_row(form.gender) }}

                <h6 class="mt-4 mb-2 text-muted">Рождение</h6>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.birthDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.birthYear) }}</div>
                </div>
                {{ form_row(form.birthPlace) }}

                <h6 class="mt-3 mb-2 text-muted">Смерть</h6>
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.deathDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.deathYear) }}</div>
                </div>
                {{ form_row(form.deathPlace) }}

                {{ form_row(form.notes) }}
                {{ form_row(form.externalTreeUrl) }}

                <div class="d-flex justify-content-between mt-4">
                    <a href="{{ path('persons_index') }}" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
