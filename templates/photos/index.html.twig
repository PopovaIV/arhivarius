{% extends 'base.html.twig' %}
{% block title %}Фотоальбом — {{ app_name }}{% endblock %}

{% block stylesheets %}
<style>
    .photo-tile { aspect-ratio: 1; overflow: hidden; background: #f1f3f5; border-radius: 0.5rem; }
    .photo-tile img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.2s; }
    .photo-tile:hover img { transform: scale(1.03); }
    .photo-tile-overlay {
        position: absolute; bottom: 0; left: 0; right: 0;
        padding: 0.5rem 0.75rem; color: #fff;
        background: linear-gradient(transparent, rgba(0,0,0,0.7));
        font-size: 0.85rem;
    }
</style>
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2><i class="bi bi-images"></i> Фотоальбом <small class="text-muted">{{ total }}</small></h2>
        <a href="{{ path('persons_index') }}" class="text-decoration-none small">
            <i class="bi bi-people"></i> Список людей
        </a>
    </div>
    {% if is_granted('ROLE_CONTRIBUTOR') %}
    <a href="{{ path('photos_new') }}" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Загрузить фото
    </a>
    {% endif %}
</div>

<div class="row g-3">
    {% for ph in photos %}
        <div class="col-6 col-md-4 col-lg-3">
            <a href="{{ path('photos_show', {id: ph.id}) }}" class="text-decoration-none text-white d-block position-relative photo-tile shadow-sm">
                <img src="{{ path('photos_image', {id: ph.id}) }}" alt="{{ ph.title }}" loading="lazy">
                <div class="photo-tile-overlay">
                    <div class="fw-semibold text-truncate">{{ ph.title }}</div>
                    <div class="small opacity-75">
                        {% if ph.takenYear %}{{ ph.takenYear }}{% endif %}
                        {% if ph.tags|length > 0 %} · <i class="bi bi-person"></i> {{ ph.tags|length }}{% endif %}
                    </div>
                </div>
            </a>
        </div>
    {% else %}
        <div class="col-12 text-center text-muted py-5">
            Фотографий пока нет.
            {% if is_granted('ROLE_CONTRIBUTOR') %}
                <a href="{{ path('photos_new') }}">Загрузить первую</a>?
            {% endif %}
        </div>
    {% endfor %}
</div>

{% set pages = (total / per_page)|round(0, 'ceil') %}
{% if pages > 1 %}
<nav class="mt-3">
    <ul class="pagination">
        {% for p in 1..pages %}
            <li class="page-item {{ p == page ? 'active' }}">
                <a class="page-link" href="?page={{ p }}">{{ p }}</a>
            </li>
        {% endfor %}
    </ul>
</nav>
{% endif %}
{% endblock %}
