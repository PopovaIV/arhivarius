{% extends 'base.html.twig' %}
{% block title %}Загрузить фото — Фотоальбом{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-7">
        <a href="{{ path('photos_index') }}" class="text-muted text-decoration-none small">
            <i class="bi bi-arrow-left"></i> Фотоальбом
        </a>
        <h2 class="mt-1 mb-4"><i class="bi bi-cloud-upload"></i> Новая фотография</h2>

        <div class="card shadow-sm">
            <div class="card-body p-4">
                {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
                {{ form_row(form.imageFile) }}
                {{ form_row(form.title) }}
                {{ form_row(form.description) }}
                <div class="row">
                    <div class="col-md-6">{{ form_row(form.takenDate) }}</div>
                    <div class="col-md-6">{{ form_row(form.takenYear) }}</div>
                </div>
                {{ form_row(form.place) }}

                <div class="alert alert-light border small mb-3">
                    <i class="bi bi-info-circle"></i> Тегировать людей на фото можно будет на странице фотографии после загрузки.
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('photos_index') }}" class="btn btn-outline-secondary">Отмена</a>
                    <button type="submit" class="btn btn-primary">Загрузить</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
